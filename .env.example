# E-commerce Recommendation Agent - Environment Variables
# Local development: copy to backend/.env (or project root .env)
# Docker Compose: copy to project root .env

APP_ENV=development
SECRET_KEY=change-this-in-production

# Local development defaults (Docker Compose overrides hosts to postgres/redis/chromadb)
DATABASE_URL=postgresql+asyncpg://ecomuser:ecompass@localhost:5432/ecom_agent
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost
CHROMA_PORT=8000

# OpenAI
OPENAI_API_KEY=sk-your-key-here
# 商品管理白名单（JSON 数组，注册用户的邮箱须与其匹配）
PRODUCT_MANAGER_EMAILS=[]
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MODEL_FAST=gpt-3.5-turbo
EMBEDDING_MODEL=text-embedding-3-small

# Optional overrides
# LOG_LEVEL=INFO
# CORS_ORIGINS=["http://localhost","http://localhost:5173"]
